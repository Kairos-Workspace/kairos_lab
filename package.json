{
  "name": "kairos-strategy-tester",
  "version": "1.1.0",
  "description": "Desktop Strategy Tester and Market Replay",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "electron-vite build",
    "build:web": "vite build",
    "deploy:pages": "npm run build:web && npx wrangler pages deploy dist-web",
    "preview": "electron-vite preview",
    "preview:web": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "download:xauusd": "node scripts/download-xauusd-jetta.mjs",
    "export:csv": "node scripts/export-csv.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "better-sqlite3": "^12.4.1",
    "dukascopy-node": "^1.50.0",
    "lightweight-charts": "^5.0.8",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-toastify": "^11.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.kairos.strategy-tester",
    "productName": "Kairos",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          ".gitkeep"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
